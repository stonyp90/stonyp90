{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "anthonypaquet-com",
  "main": "worker/index.js",
  "compatibility_date": "2026-09-01",
  "workers_dev": true,
  "preview_urls": false,
  "vars": {
    // Requests to any other host are 301-redirected here (path and query preserved).
    "CANONICAL_HOST": "www.anthonypaquet.com"
  },
  "routes": [
    { "pattern": "www.anthonypaquet.com", "custom_domain": true },
    { "pattern": "anthonypaquet.com", "custom_domain": true }
  ],
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": true
  }
}
